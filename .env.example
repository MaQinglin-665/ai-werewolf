DATABASE_URL="file:./dev.db"

# mock keeps the app fully local. Set to "openai" for one OpenAI model, or "models" to route each AI persona to its matching model.
AI_SPEECH_PROVIDER="mock"
AI_ACTION_PROVIDER="mock"
# Backward-compatible alias for AI_ACTION_PROVIDER. Leave empty unless you need the old name.
AI_DECISION_PROVIDER=""
# guided lets LLMs choose their own public speech within hard safety/legal boundaries.
# Use "strict" for the old speechPlan-as-script behavior, or "loose" for more dramatic table talk.
AI_SPEECH_STRICTNESS="guided"

# OpenAI-compatible multi-model gateway for DeepSeek / Claude / GPT / Doubao / Mimo / Gemini / GLM / Kimi.
AI_LLM_PROVIDER="mock"
# Backward-compatible alias for AI_LLM_PROVIDER.
AI_PROVIDER=""
AI_LLM_BASE_URL=""
OPENAI_BASE_URL=""
AI_LLM_API_KEY=""
AI_LLM_TIMEOUT_MS="12000"
AI_LLM_SPEECH_TIMEOUT_MS="45000"
AI_LLM_SPEECH_TIMEOUT_MS_CAP="90000"
AI_LLM_MAX_RETRIES="1"
AI_LLM_ACTION_MAX_TOKENS="1800"
AI_LLM_SPEECH_MAX_TOKENS="2400"
AI_LLM_SPEECH_MAX_TOKENS_CAP="3200"
AI_LLM_DISABLE_THINKING="true"
AI_LLM_TEMPERATURE="0.72"
AI_LLM_ACTION_TEMPERATURE="0.45"
AI_LLM_SPEECH_TEMPERATURE="0.72"
AI_LLM_JSON_MODE="off"
# Set to "true" only when tests should hit real routed LLMs.
AI_LLM_IN_TESTS="false"
# Optional: Volcengine Ark key. When set, Doubao and GLM routes use Ark before the generic gateway.
ARK_API_KEY=""
# Optional Mimo-compatible key aliases used by host/audio routes.
XIAOMI_API_KEY=""
CXSEE_API_KEY=""
AI_MODEL_DEEPSEEK="deepseek-v4-flash"
AI_MODEL_CLAUDE="claude-opus-4-6"
AI_MODEL_GPT="gpt-5.4"
AI_MODEL_DOUBAO="doubao-seed-2-0-pro-260215"
AI_MODEL_MIMO="mimo-v2.5-pro"
AI_MODEL_GEMINI="gemini-3-flash"
GEMINI_FALLBACK_MODELS="gemini-3.1-pro,gemini-3.1-pro-preview"
AI_MODEL_GLM="glm-4-7-251222"
AI_MODEL_KIMI="kimi-k2.6"
MIMO_LLM_API_KEY=""
MIMO_LLM_BASE_URL=""
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
KIMI_TEMPERATURE="0.6"
KIMI_SPEECH_MAX_TOKENS="2400"
KIMI_ACTION_MAX_TOKENS="1800"
GLM_SPEECH_TIMEOUT_MS="90000"

# Required only when AI_SPEECH_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional: browser voice input uses Web Speech in the client, then this server-side LLM rewrite cleans up the transcript.
VOICE_INPUT_REWRITE_PROVIDER=""
VOICE_INPUT_STT_PROVIDER="openai"
VOICE_INPUT_STT_MODEL="gpt-4o-mini-transcribe"
VOICE_INPUT_TEST_TRANSCRIPT=""
VOICE_INPUT_MAX_TRANSCRIPT_CHARS="1200"
VOICE_INPUT_REWRITE_PERSONA="GPT"
VOICE_INPUT_REWRITE_TEMPERATURE="0.2"

# Used only by npm run audio:host to generate fixed local mp3 files.
HOST_AUDIO_TTS_PROVIDER="openai"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="cedar"
OPENAI_TTS_INSTRUCTIONS="中文狼人杀主持人。低沉、克制、清晰，有悬疑感，语速略慢，像真人桌游法官。"

# Alternative offline host-audio generator.
MIMO_API_KEY=""
# If your Mimo LLM key also has TTS permission, MIMO_LLM_API_KEY can be reused by the TTS route.
# tp- keys use https://token-plan-cn.xiaomimimo.com automatically if this is omitted.
MIMO_TTS_BASE_URL=""
MIMO_TTS_MODEL="mimo-v2.5-tts"
MIMO_TTS_VOICE="mimo_default"
MIMO_TTS_FORMAT="mp3"
MIMO_TTS_STYLE="低沉 悬疑 变慢"
MIMO_TTS_USE_STYLE_TAG="false"
MIMO_AUTH_HEADER=""

# Optional: AI public-speech voice generation. These default to Mimo documented voices plus per-character style tags.
MIMO_AI_TTS_MODEL="mimo-v2.5-tts"
MIMO_AI_TTS_FORMAT="mp3"
MIMO_AI_TTS_VOICE=""
MIMO_AI_TTS_FALLBACK_VOICE="mimo_default"
MIMO_AI_VOICE_DEEPSEEK="mimo_default"
MIMO_AI_VOICE_CLAUDE="mimo_default"
MIMO_AI_VOICE_GPT="default_zh"
MIMO_AI_VOICE_DOUBAO="default_zh"
MIMO_AI_VOICE_MIMO="mimo_default"
MIMO_AI_VOICE_GEMINI="mimo_default"
MIMO_AI_VOICE_GLM="default_zh"
MIMO_AI_VOICE_KIMI="mimo_default"

# Optional simulation controls for npm run simulate:ai.
SIM_BOARD_ID=""
SIM_GAMES="1000"
SIM_SEED_START="0"
SIM_MAX_STEPS="500"
