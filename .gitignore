# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local scratch and Codex workflow artifacts
/tmp/
/.superpowers/
/promo-ai-werewolf/

# local database and generated prisma client
/prisma/dev.db
/prisma/dev.db-journal
/src/generated/prisma

# local multiplayer room snapshots
/.local/

# generated runtime speech cache
/public/audio/ai-speech/*.mp3
/public/audio/ai-speech/*.wav
/public/audio/ai-speech/*.aac
/public/audio/ai-speech/*.flac

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.*.log
dev-server-*.log
start-server*.log
codex-dev-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
